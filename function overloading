#include<iostream>
using namespace std;

int area(int);
int area(int,int);
float area(float);
float area(float,float);
int main()
{
    int a,l,b;
    float r,ht,bs;
    cout<<"enter side of square:";  //a
    cin>>a;
    cout<<"enter height and breadth of rectangle:";
    cin>>l>>b;
    cout<<"enter radius:"; //r
    cin>>r;
    cout<<"enter value of height and base of triangle:";
    cin>>ht>>bs;
    cout<<area(a)<<endl;
    cout<<area(l,b)<<endl;
    cout<<area(r)<<endl;
    cout<<area(ht,bs)<<endl;
    
    
}
int area(int a)
{
    return (a*a);
}
int area(int l,int b)
{
    return (l*b);
}
float area(float r)
{
    return (r*r*3.14);
}
float area(float ht, float bs)
{
    return(ht*bs/2);
}
